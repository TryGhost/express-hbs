{
  "name": "express-hbs",
  "version": "3.0.0",
  "description": "Express handlebars template engine complete with multiple layouts, partials and blocks.",
  "keywords": [
    "express4",
    "express",
    "handlebars",
    "layout",
    "partials"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "test": "mocha",
    "posttest": "pnpm lint",
    "coverage": "nyc --check-coverage mocha",
    "preship": "pnpm test",
    "ship": "pro-ship"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/express-hbs"
  },
  "bugs": "https://github.com/TryGhost/express-hbs/issues",
  "author": "Mario Gutierrez <mario@barc.com>",
  "license": "MIT",
  "devDependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "i18n": "0.15.4",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "rewire": "9.0.1",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "@tryghost/pro-ship": "1.1.9",
    "handlebars": "4.7.10",
    "lodash": "4.18.1",
    "readdirp": "3.6.0"
  },
  "optionalDependencies": {
    "js-beautify": "^2.0.0"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
