{
  "name": "express-hbs",
  "version": "3.0.0",
  "description": "Express handlebars template engine complete with multiple layouts, partials and blocks.",
  "keywords": [
    "express4",
    "express",
    "handlebars",
    "layout",
    "partials"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "test": "mocha",
    "posttest": "pnpm lint",
    "coverage": "nyc --check-coverage mocha",
    "preship": "pnpm test",
    "ship": "pro-ship"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/express-hbs"
  },
  "bugs": "https://github.com/TryGhost/express-hbs/issues",
  "author": "Mario Gutierrez <mario@barc.com>",
  "license": "MIT",
  "devDependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "i18n": "0.15.4",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "rewire": "9.0.1",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "@tryghost/pro-ship": "1.1.9",
    "handlebars": "4.7.9",
    "lodash": "4.18.1",
    "readdirp": "3.6.0"
  },
  "optionalDependencies": {
    "js-beautify": "^2.0.0"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
