{
  "name": "express-hbs",
  "version": "4.0.2",
  "description": "Express handlebars template engine complete with multiple layouts, partials and blocks.",
  "keywords": [
    "express4",
    "express",
    "handlebars",
    "layout",
    "partials"
  ],
  "main": "index.js",
  "files": [
    "index.js",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "example": "example"
  },
  "scripts": {
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "test": "mocha",
    "posttest": "pnpm lint",
    "coverage": "nyc --check-coverage mocha",
    "preship": "pnpm test",
    "ship": "pro-ship"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TryGhost/express-hbs"
  },
  "bugs": "https://github.com/TryGhost/express-hbs/issues",
  "author": "Mario Gutierrez <mario@barc.com>",
  "license": "MIT",
  "devDependencies": {
    "@tryghost/pro-ship": "2.0.4",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "i18n": "0.15.4",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "rewire": "9.0.1",
    "supertest": "7.3.2"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "lodash": "^4.18.1",
    "readdirp": "^3.6.0"
  },
  "optionalDependencies": {
    "js-beautify": "^2.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
